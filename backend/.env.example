TELEGRAM_BOT_TOKEN=replace_me
DATABASE_URL=postgresql://qcup:qcup_local_password@localhost:5432/qcup?schema=public
API_PORT=4000

# NFT-подарки: ключ Gift Asset API (получить у @giftasset_api_tokens_bot) и шаблон картинок коллекций
GIFTASSET_API_KEY=
NFT_IMAGE_TEMPLATE=

# Монетизация: безопасно выключена по умолчанию. Не включать до проверки лицензии,
# юрисдикций, правил Telegram и подключения сертифицированного провайдера.
PAYMENTS_ENABLED=false
WITHDRAWALS_ENABLED=false
ADMIN_API_TOKEN=replace_with_long_random_secret
# Цена QCP фиксируется в рублях; FX задаётся оператором/провайдером, не берётся с клиента.
QCP_RUB_RATE=1
TON_RUB_RATE=0
STARS_RUB_RATE=0
